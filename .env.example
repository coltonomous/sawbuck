# PostgreSQL connection
DATABASE_URL=postgresql://postgres:sawbuck@localhost:5432/sawbuck

# AWS — required for Bedrock AI + CloudWatch logging
# Configure credentials via env vars, ~/.aws/credentials, or IAM role
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional — eBay Browse API for pricing comparables
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# Optional — fal.ai for concept render generation
# FAL_KEY=

# Optional — production domain for Caddy TLS
# DOMAIN=sawbuck.example.com
# CORS_ORIGIN=https://sawbuck.example.com
# PORT=3001

# ─── Agent Pipeline Configuration ───────────────────────────
# All values below have sensible defaults. Override as needed.

# Models (Bedrock model IDs) — defaults to Qwen via Converse API
# Any model supporting Converse works: Qwen, Claude, Llama, etc.
# AGENT_TRIAGE_MODEL=qwen.qwen3-32b-v1:0
# AGENT_EVAL_MODEL=qwen.qwen3-vl-235b-a22b

# Scheduling
# AGENT_RUN_INTERVAL_MS=14400000        # 4 hours (default)

# Per-run caps
# AGENT_MAX_TRIAGES=50                  # max listings to triage per run
# AGENT_MAX_EVALS=10                    # max listings to evaluate (vision) per run
# AGENT_MAX_RENDERS=5                   # max listings to render concepts for
# AGENT_CONCEPTS_PER_LISTING=1          # concept images per listing

# Quality gates
# AGENT_TRIAGE_THRESHOLD=0.6            # min confidence to pass triage
# AGENT_DEAL_SCORE_THRESHOLD=1.3        # min deal score to qualify

# Scraping
# AGENT_TARGET_CITY=seattle
# AGENT_DAILY_REQUEST_CAP=200
# AGENT_MIN_DELAY_MS=1500               # min delay between detail page fetches
# AGENT_MAX_DELAY_MS=4000               # max delay between detail page fetches

# Image management
# AGENT_IMAGE_RETENTION_DAYS=14         # days to keep agent listing images
# AGENT_FAL_MODEL=fal-ai/flux/dev
# AGENT_CONCEPT_SIZE=768                # concept render dimensions (square)
