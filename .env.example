# Optional — server-side fallback key for Claude API
# If not set, users must provide their own key in Settings
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables eBay Browse API for active listing comps
# Register at https://developer.ebay.com to get credentials
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Facebook Marketplace — reads session cookies automatically from Chrome/Firefox.
# Just be logged into Facebook in your browser. For Docker/headless environments,
# export cookies to data/fb-cookies.json instead (needs c_user and xs cookies).

# Required for production — your domain for Caddy TLS
# DOMAIN=sawbuck.example.com

# Optional — restrict CORS origin
# CORS_ORIGIN=https://sawbuck.example.com

# Optional — change server port (defaults to 3001)
# PORT=3001
