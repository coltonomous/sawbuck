ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables eBay Browse API for active listing comps
# Register at https://developer.ebay.com to get credentials
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional — restrict CORS origin (defaults to http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173

# Optional — protect API routes with a bearer token
# API_KEY=

# Optional — change server port (defaults to 3001)
# PORT=3001
