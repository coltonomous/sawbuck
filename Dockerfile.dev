FROM node:22-slim

# Build tools for native modules (sharp)
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Server + config (source is mounted over these in dev)
COPY server/ ./server/
COPY drizzle/ ./drizzle/
COPY client/ ./client/
COPY shared/ ./shared/
COPY scripts/ ./scripts/
COPY drizzle.config.ts tsconfig.json ./

RUN mkdir -p /app/data

EXPOSE 3001 5173
