{
  "name": "sawbuck",
  "version": "1.0.0",
  "description": "Find underpriced furniture, plan refinishing, source parts, track projects",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch --env-file=.env server/index.ts\" \"cd client && npx vite\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:client": "cd client && npx vite",
    "build": "cd client && npx vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "init": "tsx scripts/init.ts",
    "seed": "tsx scripts/seed.ts",
    "agent": "tsx --env-file=.env scripts/agent-runner.ts",
    "test": "vitest",
    "test:vision": "tsx scripts/test-vision.ts",
    "ingest": "tsx scripts/ingest.ts",
    "cleanup:images": "tsx scripts/cleanup-images.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.28.1",
    "@fal-ai/client": "^1.9.5",
    "@hono/node-server": "^1.19.9",
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.2.8",
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.5.6",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "fast-xml-parser": "^5.5.11",
    "hono": "^4.12.2",
    "hono-pino": "^0.10.3",
    "leaflet": "^1.9.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "sharp": "^0.34.5",
    "sqlite-vec": "^0.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
